# ---- 路径 ----
HQ_DIR=/opt/hyperqwen                     # HyperQwen(170hx 分支) 的克隆目录
MODEL=/models/Qwen3.8-27B-W8A16           # compressed-tensors 检查点目录（权重不随仓库发布）
PORT=18020

# ---- 上下文 / 批 ----
CTX=fast                                  # fast = bf16 KV + FLASH_ATTN
MAX_LEN=262144
MAX_SEQS=8
GPU_UTIL=0.95
BATCH_TOKENS=16384                        # 上游 launcher 硬编码 2048，这里覆盖

# ---- 投机解码 ----
SPEC=mtp
DRAFT_TOKENS=3
MTP_DRAFT_VOCAB=0                         # 没有 prepare/ 生成的草稿词表时置 0

# ---- 本仓库的核心开关 ----
SPEC_ATTN=1                               # 打开 split-KV verify attention
VLLM_SPEC_ATTN_NSEG=16                    # 固定 16 段；0 = 自适应
VLLM_SPEC_ATTN_MIN_BATCH=0                # 0 = 单流也走 split-KV
CUDAGRAPH_MODE=PIECEWISE                  # 短上下文必须开；NONE 会慢 18%

# ---- GA100(sm80) 稳定性 ----
VLLM_MARLIN_REPACK_STAGED=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
